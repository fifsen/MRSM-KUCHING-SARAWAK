rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Entity Validation Blueprints
    function isValidArchitectProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDraftMap(draft) {
      return draft is map
        && draft.keys().hasAll(['config', 'step', 'savedAt'])
        && draft.keys().hasOnly(['config', 'step', 'savedAt'])
        && (draft.step == 2 || draft.step == 3)
        && draft.savedAt is number
        && draft.config is map
        && draft.config.keys().hasAll([
          'difficulty', 'missionId', 'bus', 'power', 'propulsion',
          'propellantKg', 'antenna', 'shielding', 'redundancy',
          'instruments', 'rocket', 'autoFuel'
        ])
        && draft.config.keys().hasOnly([
          'difficulty', 'missionId', 'bus', 'power', 'propulsion',
          'propellantKg', 'antenna', 'shielding', 'redundancy',
          'instruments', 'rocket', 'autoFuel'
        ])
        && draft.config.difficulty is string
        && draft.config.difficulty.size() <= 32
        && draft.config.missionId in ['lunar', 'mars', 'asteroid', 'europa']
        && draft.config.bus is string
        && draft.config.bus.size() <= 32
        && draft.config.power is string
        && draft.config.power.size() <= 32
        && draft.config.propulsion is string
        && draft.config.propulsion.size() <= 32
        && draft.config.antenna is string
        && draft.config.antenna.size() <= 32
        && draft.config.shielding is string
        && draft.config.shielding.size() <= 32
        && draft.config.redundancy is string
        && draft.config.redundancy.size() <= 32
        && draft.config.rocket is string
        && draft.config.rocket.size() <= 32
        && draft.config.propellantKg is number
        && draft.config.propellantKg >= 0
        && draft.config.propellantKg <= 12000
        && draft.config.autoFuel is bool
        && draft.config.instruments is list
        && draft.config.instruments.size() <= 9
        && (draft.config.instruments.size() == 0 || (draft.config.instruments[0] is string && draft.config.instruments[0].size() <= 32));
    }

    function isValidArchitectProgress(data, userId) {
      return data.keys().hasAll(['ownerId', 'bestScores', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'bestScores', 'draft', 'updatedAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.bestScores is map
        && data.bestScores.keys().hasOnly(['lunar', 'mars', 'asteroid', 'europa'])
        && (!('draft' in data) || data.draft == null || isValidDraftMap(data.draft))
        && data.updatedAt is timestamp;
    }

    // Owner-Only User Profile Document
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidArchitectProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidArchitectProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;

      // Owner-Only Progress Subcollection (Master Gate checks parent user doc exists)
      match /progress/{progressId} {
        allow get: if isValidId(userId)
          && isValidId(progressId)
          && progressId == 'state'
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));
        allow list: if false;
        allow create: if isValidId(userId)
          && isValidId(progressId)
          && progressId == 'state'
          && isOwner(userId)
          && isValidArchitectProgress(incoming(), userId)
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidId(progressId)
          && progressId == 'state'
          && isOwner(userId)
          && isValidArchitectProgress(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['bestScores', 'draft', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if false;
      }
    }
  }
}
